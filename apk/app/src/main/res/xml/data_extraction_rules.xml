<?xml version="1.0" encoding="utf-8"?>
<!--
    Ничего не отдаём ни в облачный бэкап, ни при переносе на другое устройство:
    в DataStore лежат ключ TMDB и история просмотров. На Android 12+ одного
    allowBackup="false" для переноса устройство-устройство уже мало.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
